# TypeSafe API key for live Jev assessments. Server-side only; never sent to the browser.
# Create one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Model alias or pinned version (e.g. jev-1.13.0). Pin a version once thresholds are tuned.
JEV_MODEL=jev-latest

# Seconds to wait for Jev before failing the assessment.
JEV_TIMEOUT_SECONDS=10

# Where releases and checklist progress are stored.
DATA_PATH=data/releases.json
